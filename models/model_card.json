{
  "name": "Stud-AI risk model",
  "question": "How likely is it that the student will NOT pass the next examination in a given subject?",
  "output": "risk = probability of not passing, 0-1; shown as 'Estimated risk of not passing the next <subject> examination: NN%'",
  "model": "CatBoostClassifier (gradient-boosted decision trees), one model for every subject",
  "subjects_trained_on": [
    "mathematics",
    "english",
    "science",
    "history",
    "geography"
  ],
  "features": [
    "subject",
    "attendance",
    "homework",
    "tests_known",
    "latest",
    "average",
    "lowest",
    "highest",
    "trend",
    "other_average",
    "other_homework",
    "other_attendance"
  ],
  "categorical_features": [
    "subject"
  ],
  "monotone_constraints": {
    "subject": 0,
    "attendance": -1,
    "homework": -1,
    "tests_known": 0,
    "latest": -1,
    "average": -1,
    "lowest": -1,
    "highest": -1,
    "trend": 0,
    "other_average": -1,
    "other_homework": -1,
    "other_attendance": -1
  },
  "not_used": [
    "student_id",
    "sr_no",
    "age",
    "gender",
    "other subjects' pass/fail (decided at the same time, so unknown beforehand)"
  ],
  "params": {
    "loss_function": "Logloss",
    "eval_metric": "Logloss",
    "iterations": 5000,
    "learning_rate": 0.05,
    "depth": 6,
    "l2_leaf_reg": 30,
    "one_hot_max_size": 10,
    "random_seed": 42,
    "od_type": "Iter",
    "od_wait": 300
  },
  "trees": 239,
  "threshold": 0.5,
  "imputation_medians": {
    "attendance": 96.84,
    "homework": 84.62,
    "tests_known": 3.0,
